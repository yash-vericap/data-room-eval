# Copy this file to .env and fill in what you need. Never share or commit .env.

# --- The model: Google Gemini (free key from aistudio.google.com) ---
# GEMINI_API_KEY=
# EVAL_JUDGE_PROVIDER=gemini
# Models tried in order; when one is busy or its free allowance runs out, the next carries on:
# EVAL_JUDGE_CHAIN=gemini-flash-latest, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-flash-lite-latest
# EVAL_TRUSTED_PROVIDERS=gemini         # allows a free tier under the strict data policy, on purpose
# EVAL_RC_FOCUS=1                       # 1: each case sees only the findings related to it (default); 0: every finding
# EVAL_RC_MIN_RELEVANCE=0.20            # how related a finding must be to be shown for a case

# --- Or GitHub Models ---
# GitHub Models (free GPT models with a GitHub account). Token: github.com > Settings > Developer settings >
# Personal access tokens > Fine-grained token, with the account permission "Models: Read-only".
GITHUB_MODELS_TOKEN=

# --- Optional judge settings ---
# EVAL_JUDGE_PROVIDER=github          # github | local | custom
# EVAL_JUDGE_MODEL=openai/gpt-4.1-mini
# EVAL_JUDGE_RPM=10                   # requests per minute to stay under the free limit
# EVAL_JUDGE_PASSES=2                 # 2 = judge every finding twice (stability check); 1 halves the requests
# EVAL_JUDGE_ON_SUBMIT=1              # 1: judge every run as it arrives, 0: only when asked
# EVAL_JUDGE_BASE_URL=                # with EVAL_JUDGE_PROVIDER=custom: another OpenAI-style endpoint
# EVAL_JUDGE_API_KEY=

# --- Data security (see README, "Data security and storage") ---
# EVAL_DATA_POLICY=strict             # strict (default): only a local model or a trusted provider. open: any preset.
# EVAL_TRUSTED_PROVIDERS=             # providers allowed under strict, for example: github
# EVAL_ALLOWED_HOSTS=                 # hosts a request may go to; default: the configured provider's host
# EVAL_MIN_CANDIDATE_SEVERITY=Medium  # a real issue below this is rejected as not a major red flag
# A model on this machine (for example Ollama): EVAL_JUDGE_PROVIDER=local, EVAL_JUDGE_MODEL=<its name>,
# and EVAL_JUDGE_BASE_URL if it is not http://localhost:11434/v1

# --- Document storage (see README, "Data security and storage") ---
# MONGO_URI=mongodb://admin:secret@localhost:27017/?authSource=admin   # the local container in docker-compose.yml
# MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/   # MongoDB Atlas; add its host to EVAL_ALLOWED_HOSTS
# MONGO_DB=dataroom_eval
# EVAL_STORE_PDFS=1                   # store the PDFs as well as the page text

# --- Needed on a server only ---
EVAL_APP_PASSWORD=
EVAL_API_KEY=
